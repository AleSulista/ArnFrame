{
  "id": "space.phaser",
  "displayName": "Phaser",
  "category": "space",
  "order": 440,
  "backend": "avfilter",
  "chain": "aphaser=in_gain={in_gain}:out_gain={out_gain}:delay={delay}:decay={decay}:speed={speed}",
  "prerollMs": 150,
  "parameters": [
    {
      "identifier": "speed",
      "displayName": "Speed",
      "type": "float",
      "minValue": 0.1,
      "maxValue": 2.0,
      "defaultValue": 0.5
    },
    {
      "identifier": "in_gain",
      "displayName": "Input",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.6
    },
    {
      "identifier": "out_gain",
      "displayName": "Output",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.7
    },
    {
      "identifier": "delay",
      "displayName": "Delay",
      "type": "float",
      "minValue": 0,
      "maxValue": 5,
      "defaultValue": 3
    },
    {
      "identifier": "decay",
      "displayName": "Decay",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.4
    }
  ]
}

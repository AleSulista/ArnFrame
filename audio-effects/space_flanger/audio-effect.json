{
  "id": "space.flanger",
  "displayName": "Flanger",
  "category": "space",
  "order": 430,
  "backend": "avfilter",
  "chain": "flanger=delay={delay}:depth={depth}:regen={regen}:speed={speed}",
  "prerollMs": 150,
  "parameters": [
    {
      "identifier": "speed",
      "displayName": "Speed",
      "type": "float",
      "minValue": 0.1,
      "maxValue": 10.0,
      "defaultValue": 0.5
    },
    {
      "identifier": "delay",
      "displayName": "Delay (ms)",
      "type": "float",
      "minValue": 0,
      "maxValue": 20,
      "defaultValue": 5
    },
    {
      "identifier": "depth",
      "displayName": "Depth",
      "type": "float",
      "minValue": 0,
      "maxValue": 10,
      "defaultValue": 2
    },
    {
      "identifier": "regen",
      "displayName": "Feedback",
      "type": "float",
      "minValue": -95,
      "maxValue": 95,
      "defaultValue": 0
    }
  ]
}
